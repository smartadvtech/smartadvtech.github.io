---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada · SmartADV" descricao="A página que você procurou não existe.">
  <section class="mx-auto flex max-w-3xl flex-col items-start px-4 py-32 sm:px-6">
    <p class="eyebrow flex items-center gap-4 text-ouro-800">
      <span class="filete" aria-hidden="true"></span>
      Erro 404
    </p>
    <h1 class="mt-5 font-serif text-5xl font-semibold text-navy-950">Página não encontrada</h1>
    <p class="mt-5 text-lg text-tinta-suave">O endereço pode ter mudado, ou a página não existe mais.</p>
    <a href="/" class="botao-ouro mt-10">Voltar para o início</a>
  </section>
</Base>
