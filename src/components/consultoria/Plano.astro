---
// O plano em quatro fases, a seção que a página quer que fique na memória: as fases da home, com a primeira aberta nas
// entregas dela, porque é por ela que todo escritório começa.
import Titulo from '../Titulo.astro';
import { destaqueDaFundacao, fundacao } from '../../data/consultoria';
import { jornada } from '../../data/site';
---

<section id="plano" class="relative overflow-hidden bg-navy-950" aria-labelledby="plano-titulo">
  <div class="mx-auto grid max-w-6xl gap-14 px-4 py-24 sm:px-6 lg:grid-cols-[1fr_1.9fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <Titulo
        id="plano-titulo"
        tema="escuro"
        eyebrow="O plano"
        titulo="Quatro fases, uma de cada vez"
        texto="Cada fase depende da anterior: primeiro a base, depois a autonomia da equipe, a captação e, por fim, a maturidade. O escritório avança no próprio ritmo."
      />
    </div>

    <ol>
      {
        jornada.map(({ titulo, texto, entregas }, i) => {
          const primeira = i === 0;
          return (
            <li class="group relative grid grid-cols-[3rem_1fr] gap-x-5 pb-16 last:pb-0 sm:grid-cols-[4.5rem_1fr] sm:gap-x-8">
              {/* A linha que liga um número ao seguinte */}
              <span class="absolute top-20 bottom-4 left-6 w-px bg-ouro-500/30 group-last:hidden sm:left-9" aria-hidden="true" />
              <p
                class="bg-linear-to-b from-ouro-300 to-ouro-600 bg-clip-text text-center font-serif text-7xl leading-none font-semibold text-transparent sm:text-8xl"
                aria-hidden="true"
              >
                {i + 1}
              </p>
              <div class="pt-2">
                <h3 class="font-serif text-3xl leading-tight font-semibold text-white sm:text-4xl">
                  <span class="sr-only">Fase {i + 1}: </span>
                  {titulo}
                </h3>
                <p class="mt-3 max-w-xl leading-relaxed text-nevoa">{texto}</p>
                {primeira ? (
                  <div class="mt-8 rounded-sm border border-white/10 bg-navy-900 p-6 sm:p-8">
                    <p class="font-semibold text-ouro-300">{destaqueDaFundacao}</p>
                    <ul class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2">
                      {fundacao.map(({ titulo, texto }) => (
                        <li>
                          <h4 class="flex items-center gap-2.5 font-semibold text-white">
                            <svg class="size-4 shrink-0 text-ouro-500" viewBox="0 0 16 16" aria-hidden="true">
                              <path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            {titulo}
                          </h4>
                          <p class="mt-2 text-sm leading-relaxed text-nevoa-suave">{texto}</p>
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : (
                  <ul class="mt-5 space-y-2 text-sm text-nevoa">
                    {entregas.map((entrega) => (
                      <li class="flex gap-2.5 leading-relaxed">
                        <span class="mt-2.5 h-px w-3 shrink-0 bg-ouro-500" aria-hidden="true" />
                        {entrega}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
