---
// O plano de evolução de um escritório, em HTML: leve, nítido em qualquer tela e legível por leitor de tela. É uma
// ilustração, de um escritório fictício, com as fases da home e a primeira em implantação.
import { cartaoDoPlano } from '../../data/consultoria';
import { jornada } from '../../data/site';
---

<figure class="mx-auto w-full max-w-sm">
  <div class="rounded-sm border border-white/10 bg-navy-900 p-6 text-left shadow-2xl shadow-black/50 sm:p-8">
    <p class="font-serif text-2xl font-semibold text-white">{cartaoDoPlano.titulo}</p>
    <ol class="mt-6 space-y-5">
      {
        jornada.map(({ fase, titulo }, i) => {
          const atual = i === 0;
          return (
            <li class:list={['border-l-2 pl-4', atual ? 'border-ouro-500' : 'border-white/15']}>
              <p class="flex items-baseline justify-between gap-3 text-xs">
                <span class="text-ouro-300">{fase}</span>
                <span class={atual ? 'text-ouro-300' : 'text-nevoa-suave'}>{cartaoDoPlano.situacoes[i]}</span>
              </p>
              <p class:list={['mt-1 font-semibold', atual ? 'text-white' : 'text-nevoa']}>{titulo}</p>
              {atual && (
                <ul class="mt-3 space-y-2 text-sm">
                  {cartaoDoPlano.itensDaPrimeira.map(({ texto, feito }) => (
                    <li class="flex items-center gap-2.5 text-nevoa">
                      {feito ? (
                        <svg class="size-4 shrink-0 text-ouro-500" viewBox="0 0 16 16" aria-label="Pronto" role="img">
                          <path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      ) : (
                        <svg class="size-4 shrink-0 text-nevoa-suave" viewBox="0 0 16 16" aria-label="Em andamento" role="img">
                          <circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3 2" />
                        </svg>
                      )}
                      {texto}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
  <figcaption class="mt-4 text-center text-xs text-nevoa-suave">Ilustração de um escritório fictício</figcaption>
</figure>
