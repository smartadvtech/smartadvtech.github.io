---
// Os sinais na voz do sócio: a frase que ele diria, grande, e o que ela quer dizer para a operação, embaixo
import Titulo from '../Titulo.astro';
import { sinais } from '../../data/consultoria';
---

<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" aria-labelledby="sinais-titulo">
  <Titulo
    id="sinais-titulo"
    eyebrow="O ponto de partida"
    titulo="Você se reconhece?"
    texto="São os sinais de um escritório que cresceu mais rápido do que a operação. E são os gargalos que já resolvemos na prática."
  />

  <ul class="mt-16 grid gap-x-16 gap-y-12 lg:grid-cols-2">
    {
      sinais.map(({ fala, texto }) => (
        <li class="border-l-2 border-ouro-600 pl-6">
          <p class="font-serif text-3xl leading-snug font-semibold text-navy-950">“{fala}”</p>
          <p class="mt-3 leading-relaxed text-tinta-suave">{texto}</p>
        </li>
      ))
    }
  </ul>
</section>
