---
import Titulo from './Titulo.astro';
import { gargalos } from '../data/site';
---

<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" aria-labelledby="gargalos-titulo">
  <Titulo
    id="gargalos-titulo"
    eyebrow="O ponto de partida"
    titulo="Os gargalos que travam o escritório"
    texto="Falta de processo e de ferramentas certas gera sobrecarga e impede o crescimento. São os gargalos que já resolvemos na prática."
  />

  <div class="mt-14 grid gap-px overflow-hidden rounded-sm border border-navy-950/10 bg-navy-950/10 lg:grid-cols-3">
    {
      gargalos.map(({ titulo, itens }, i) => (
        <article class="bg-white p-8">
          <p class="font-serif text-5xl text-ouro-800" aria-hidden="true">
            0{i + 1}
          </p>
          <h3 class="mt-4 text-lg font-semibold text-navy-950">{titulo}</h3>
          <ul class="mt-5 space-y-3 text-tinta-suave">
            {itens.map((item) => (
              <li class="flex gap-3 leading-relaxed">
                <span class="mt-2.5 size-1.5 shrink-0 rotate-45 bg-ouro-600" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
