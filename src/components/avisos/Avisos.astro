---
import Titulo from '../Titulo.astro';
import { avisos } from '../../data/avisos';
---

<section id="os-avisos" class="bg-navy-950" aria-labelledby="os-avisos-titulo">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <Titulo
      id="os-avisos-titulo"
      tema="escuro"
      eyebrow="Os avisos"
      titulo="O escritório avisa antes de o cliente perguntar"
      texto="Três avisos, sempre pelo WhatsApp oficial do escritório, a partir do que a equipe já registra no sistema de gestão. Sem trabalho a mais para ninguém."
    />

    <ul class="mt-14 grid gap-px overflow-hidden rounded-sm bg-white/10 md:grid-cols-3">
      {
        avisos.map(({ titulo, texto }) => (
          <li class="bg-navy-900 p-8">
            <h3 class="flex items-center gap-3 font-semibold text-white">
              <span class="filete w-6" aria-hidden="true" />
              {titulo}
            </h3>
            <p class="mt-3 leading-relaxed text-nevoa-suave">{texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
