---
import Titulo from '../Titulo.astro';
import { regras } from '../../data/avisos';
---

<section class="border-t border-navy-950/10 bg-white" aria-labelledby="regras-titulo">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <Titulo
      id="regras-titulo"
      eyebrow="Sem exagero"
      titulo="Avisos na medida certa"
      texto="O cliente recebe o que importa, na hora certa, e o escritório sabe exatamente o que saiu."
    />

    <dl class="mt-14 grid gap-px overflow-hidden rounded-sm border border-navy-950/10 bg-navy-950/10 sm:grid-cols-2 lg:grid-cols-3">
      {
        regras.map(({ titulo, texto }) => (
          <div class="bg-marfim p-8">
            <dt class="flex items-center gap-3 font-semibold text-navy-950">
              <span class="filete w-6" aria-hidden="true" />
              {titulo}
            </dt>
            <dd class="mt-3 leading-relaxed text-tinta-suave">{texto}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
