---
import Titulo from '../Titulo.astro';
import { ia } from '../../data/atendimento';
---

<section id="ia" class="bg-navy-950" aria-labelledby="ia-titulo">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <Titulo
      id="ia-titulo"
      tema="escuro"
      eyebrow="Adicional de IA"
      titulo="A IA responde às outras dúvidas"
      texto="Nem toda mensagem cabe no menu. Com a IA, o cliente escreve a pergunta do jeito dele e recebe a resposta na hora, inclusive à noite e no fim de semana."
    />

    <ul class="mt-14 grid gap-px overflow-hidden rounded-sm bg-white/10 md:grid-cols-3">
      {
        ia.map(({ titulo, texto }) => (
          <li class="bg-navy-900 p-8">
            <h3 class="flex items-center gap-3 font-semibold text-white">
              <span class="filete w-6" aria-hidden="true" />
              {titulo}
            </h3>
            <p class="mt-3 leading-relaxed text-nevoa-suave">{texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
