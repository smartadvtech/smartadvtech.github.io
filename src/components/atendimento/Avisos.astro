---
// O adicional dos avisos ao cliente na página do atendimento. Os três avisos são os da página deles (/avisos), que
// conta o resto: o golpe do falso advogado, as regras e as perguntas.
import Titulo from '../Titulo.astro';
import { avisos as adicional } from '../../data/atendimento';
import { avisos } from '../../data/avisos';
---

<section id="avisos" class="border-t border-navy-950/10 bg-white" aria-labelledby="avisos-titulo">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <Titulo id="avisos-titulo" eyebrow="Adicional de avisos" titulo={adicional.titulo} texto={adicional.texto} />

    <dl class="mt-14 grid gap-px overflow-hidden rounded-sm border border-navy-950/10 bg-navy-950/10 md:grid-cols-3">
      {
        avisos.map(({ titulo, texto }) => (
          <div class="bg-marfim p-8">
            <dt class="flex items-center gap-3 font-semibold text-navy-950">
              <span class="filete w-6" aria-hidden="true" />
              {titulo}
            </dt>
            <dd class="mt-3 leading-relaxed text-tinta-suave">{texto}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-8 max-w-3xl text-sm leading-relaxed text-tinta-suave">
      <p>{adicional.nota}</p>
      <a href={adicional.link.href} class="mt-3 inline-block font-semibold text-ouro-800 hover:text-ouro-600">
        {adicional.link.texto}
      </a>
    </div>
  </div>
</section>
