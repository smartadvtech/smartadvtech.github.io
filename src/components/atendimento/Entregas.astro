---
import Titulo from '../Titulo.astro';
import { entregas } from '../../data/atendimento';
---

<section class="border-t border-navy-950/10 bg-white" aria-labelledby="entregas-titulo">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <Titulo
      id="entregas-titulo"
      eyebrow="O que entregamos"
      titulo="Nós deixamos tudo pronto"
      texto="Você não precisa entender de tecnologia nem parar o escritório. A SmartADV cuida de cada etapa, da contratação das ferramentas ao primeiro atendimento."
    />

    <ul class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        entregas.map(({ titulo, texto }) => (
          <li class="flex gap-4">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-ouro-300 to-ouro-600 text-navy-950" aria-hidden="true">
              <svg class="size-4" viewBox="0 0 16 16">
                <path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div>
              <h3 class="font-semibold text-navy-950">{titulo}</h3>
              <p class="mt-2 leading-relaxed text-tinta-suave">{texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
