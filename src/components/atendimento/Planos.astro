---
import Titulo from '../Titulo.astro';
import { contato, planos } from '../../data/atendimento';
import { linkDeContato } from '../../lib/contato';

// "69,90" → os reais em destaque e os centavos menores, como numa tabela de preços
function partesDoPreco(preco: number) {
  const [reais, centavos] = preco.toLocaleString('pt-BR', { minimumFractionDigits: 2 }).split(',');
  return { reais, centavos };
}
---

<section id="planos" class="bg-navy-950" aria-labelledby="planos-titulo">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <Titulo
      id="planos-titulo"
      tema="escuro"
      eyebrow="Investimento"
      titulo="Planos"
      texto="Uma mensalidade fixa pelo atendimento automático, conforme o volume de consultas do escritório."
    />

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        planos.itens.map(({ nome, preco, cota, publico }) => {
          const { reais, centavos } = partesDoPreco(preco);
          return (
            <article class="rounded-sm border border-white/10 bg-navy-900 p-8">
              <h3 class="eyebrow text-ouro-500">{nome}</h3>
              <p class="mt-5 font-serif whitespace-nowrap text-white">
                <span class="text-2xl">R$</span> <span class="text-5xl font-semibold">{reais}</span>
                <span class="text-2xl">,{centavos}</span>
                <span class="font-sans text-sm text-nevoa">/mês</span>
              </p>
              <p class="mt-4 font-semibold text-white">Até {cota} consultas por mês</p>
              <p class="mt-1 text-sm leading-relaxed text-nevoa-suave">{publico}</p>
            </article>
          );
        })
      }
    </div>

    <div class="mt-6 grid gap-8 rounded-sm border border-ouro-500/30 p-8 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="font-semibold text-white">Todos os planos incluem</p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            planos.inclui.map((item) => (
              <li class="flex gap-3 leading-relaxed text-nevoa">
                <svg class="mt-1 size-4 shrink-0 text-ouro-500" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <a href={linkDeContato(contato)} class="botao-ouro" data-rastrear={contato.rastrear}>Quero um diagnóstico gratuito</a>
    </div>

    <div class="mt-10 max-w-3xl space-y-3 text-sm leading-relaxed text-nevoa-suave">
      <p>{planos.adicional}</p>
      <p>{planos.consulta}</p>
      <p>{planos.nota}</p>
    </div>
  </div>
</section>
