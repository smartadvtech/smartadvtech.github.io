---
// O vídeo de uma consulta real, hospedado no próprio site: um player de terceiros (YouTube, Instagram) carregaria antes
// do consentimento. Só baixa quando a pessoa aperta o play (preload="none"). Embaixo, a transcrição: o vídeo não tem
// som, e o texto dele precisa de uma alternativa para quem não o vê (WCAG 2.2, critério 1.2.1).
import Titulo from '../Titulo.astro';
import { contato, demonstracao, type Video } from '../../data/atendimento';
import { linkDeContato } from '../../lib/contato';

interface Props {
  video: Video;
}

const { video } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" aria-labelledby="demonstracao-titulo">
  <div class="grid items-center gap-14 lg:grid-cols-[1.2fr_1fr]">
    <div class="flex flex-col items-center lg:items-start">
      <Titulo id="demonstracao-titulo" eyebrow="Veja funcionando" titulo={demonstracao.titulo} texto={demonstracao.texto} />
      <a href={linkDeContato(contato)} class="botao-ouro mt-10" data-rastrear={contato.rastrear}>Quero isso no meu escritório</a>
    </div>

    <div class="mx-auto w-full max-w-xs overflow-hidden rounded-[2rem] border-8 border-navy-950 bg-navy-950 shadow-2xl shadow-navy-950/30">
      <video
        class="block h-auto w-full"
        src={video.src}
        poster={video.poster}
        width={video.largura}
        height={video.altura}
        controls
        playsinline
        preload="none"
        aria-label="Vídeo sem som: consulta de andamento de processo e pergunta respondida pela IA, numa tela do WhatsApp recriada"
      >
      </video>
    </div>
  </div>

  <details class="group mt-16 max-w-3xl border-y border-navy-950/10">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-semibold text-navy-950 hover:text-ouro-800 [&::-webkit-details-marker]:hidden">
      Transcrição do vídeo
      <svg class="size-5 shrink-0 text-ouro-600 transition-transform group-open:rotate-45" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M10 4v12M4 10h12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </summary>
    <ol class="space-y-8 pb-8 leading-relaxed text-tinta-suave">
      {
        video.transcricao.map((cena) => (
          <li class="space-y-3">
            {cena.map((trecho) =>
              typeof trecho === 'string' ? (
                <p>{trecho}</p>
              ) : (
                <p class="border-l-2 border-ouro-500/50 pl-4 whitespace-pre-line wrap-break-word">
                  <strong class="font-semibold text-navy-950">{trecho.de}:</strong> {trecho.texto}
                </p>
              ),
            )}
          </li>
        ))
      }
    </ol>
  </details>
</section>
