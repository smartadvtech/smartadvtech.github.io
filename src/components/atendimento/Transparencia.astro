---
import Titulo from '../Titulo.astro';
import { transparencia } from '../../data/atendimento';
---

<section class="border-t border-navy-950/10 bg-white" aria-labelledby="transparencia-titulo">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <Titulo
      id="transparencia-titulo"
      eyebrow="Sem burocracia"
      titulo="Transparência do começo ao fim"
      texto="Você sabe o que paga, quanto usa e onde estão os dados dos seus clientes."
    />

    <dl class="mt-14 grid gap-px overflow-hidden rounded-sm border border-navy-950/10 bg-navy-950/10 sm:grid-cols-2 lg:grid-cols-3">
      {
        transparencia.map(({ titulo, texto }) => (
          <div class="bg-marfim p-8">
            <dt class="flex items-center gap-3 font-semibold text-navy-950">
              <span class="filete w-6" aria-hidden="true" />
              {titulo}
            </dt>
            <dd class="mt-3 leading-relaxed text-tinta-suave">{texto}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
