---
import { config } from '../config';
import { contato } from '../data/site';
import { linkDeContato, linkDoWhatsApp } from '../lib/contato';
---

<section id="contato" class="relative overflow-hidden bg-navy-950" aria-labelledby="contato-titulo">
  <svg
    class="pointer-events-none absolute -top-24 -left-32 h-[30rem] w-auto rotate-180 text-ouro-500/[0.04]"
    viewBox="0 0 100 87"
    aria-hidden="true"
  >
    <path d="M50 0 100 87H0Z" fill="currentColor"></path>
  </svg>

  <div class="relative mx-auto max-w-4xl px-4 py-24 text-center sm:px-6">
    <p class="eyebrow flex items-center justify-center gap-4 text-ouro-500">
      <span class="filete" aria-hidden="true"></span>
      Contato
      <span class="filete" aria-hidden="true"></span>
    </p>
    <h2 id="contato-titulo" class="mt-6 font-serif text-4xl font-semibold text-white sm:text-5xl">{contato.titulo}</h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-nevoa">{contato.texto}</p>

    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href={linkDeContato()} class="botao-ouro" data-rastrear="contato">
        {linkDoWhatsApp() ? 'Conversar pelo WhatsApp' : 'Escrever para a SmartADV'}
      </a>
    </div>
    <p class="mt-6 text-sm text-nevoa-suave">
      ou pelo e-mail <a href={`mailto:${config.contato.email}`} class="text-ouro-300 hover:text-ouro-500">{config.contato.email}</a>
    </p>
  </div>
</section>
