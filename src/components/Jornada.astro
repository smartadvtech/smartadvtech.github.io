---
import Titulo from './Titulo.astro';
import { jornada } from '../data/site';
---

<section id="jornada" class="mx-auto max-w-6xl px-4 py-24 sm:px-6" aria-labelledby="jornada-titulo">
  <Titulo
    id="jornada-titulo"
    eyebrow="Consultoria"
    titulo="Uma jornada em 4 fases"
    texto="Cada fase depende da anterior: primeiro a base, depois a autonomia da equipe, a escala e, por fim, a maturidade. O escritório avança no próprio ritmo."
  />

  <ol class="mt-16 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-6">
    {
      jornada.map(({ fase, titulo, texto, entregas }) => (
        <li class="relative flex flex-col border-t border-ouro-600/60 pt-8">
          <span class="absolute -top-1.5 left-0 size-3 rotate-45 bg-ouro-600" aria-hidden="true" />
          <p class="eyebrow text-ouro-800">{fase}</p>
          <h3 class="mt-3 font-serif text-2xl leading-snug font-semibold text-navy-950">{titulo}</h3>
          <p class="mt-3 leading-relaxed text-tinta-suave">{texto}</p>
          <ul class="mt-5 space-y-2 text-sm text-tinta">
            {entregas.map((entrega) => (
              <li class="flex gap-2.5 leading-relaxed">
                <span class="mt-2 h-px w-3 shrink-0 bg-ouro-600" aria-hidden="true" />
                {entrega}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</section>
