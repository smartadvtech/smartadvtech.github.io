---
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo-sem-tagline.png';
import { config, temRastreamento } from '../config';

const { razaoSocial, cnpj } = config.empresa;
const ano = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-navy-950">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-10 px-4 py-14 sm:px-6 md:flex-row md:items-end md:justify-between">
    <Image src={logo} alt="SmartADV" width={176} densities={[1, 2]} class="w-44" />

    <div class="flex flex-col items-center gap-3 text-sm text-nevoa-suave md:items-end">
      <a href={`mailto:${config.contato.email}`} class="hover:text-ouro-300">{config.contato.email}</a>
      <nav aria-label="Rodapé" class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        <a href="/politica-de-privacidade" class="hover:text-ouro-300">Política de privacidade</a>
        {
          temRastreamento && (
            <button type="button" class="cursor-pointer hover:text-ouro-300" data-abrir-consentimento>
              Preferências de cookies
            </button>
          )
        }
      </nav>
      <p class="text-center text-xs md:text-right">
        © {ano} {razaoSocial || config.nome}
        {cnpj && <span class="block">CNPJ {cnpj}</span>}
      </p>
    </div>
  </div>
</footer>
